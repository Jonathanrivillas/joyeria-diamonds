# ─── Base de datos (Neon) ───────────────────────────────────────────────────────
# Neon -> rama -> Connect, con "Connection pooling" activado.
# connection_limit/pool_timeout: en un VPS de 1 CPU Prisma abriría solo 3 conexiones y Reportes
# hace ~12 consultas a la vez → "Timed out fetching a new connection".
DATABASE_URL="postgresql://USUARIO:CLAVE@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15&connection_limit=10&pool_timeout=20"
# La misma dirección pero SIN pooling (sin -pooler): la usan las migraciones.
DIRECT_URL="postgresql://USUARIO:CLAVE@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ─── Seguridad ─────────────────────────────────────────────────────────────────
# Clave larga y aleatoria (mínimo 32 caracteres). Distinta en desarrollo y en el servidor.
# Generarla:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET="cambia-esto-por-una-clave-larga-y-aleatoria"
# Fija para que los formularios abiertos sigan funcionando después de actualizar el sistema.
# Generarla:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Correos (separados por coma) de las cuentas de soporte técnico. Solo ellas ven la configuración
# de tipos de pieza y locales, y solo ellas pueden crear o cambiar administradores.
SOPORTE_EMAILS="soporte@ejemplo.com"

# ─── Recibos de gastos (fotos y PDF) ───────────────────────────────────────────
# Carpeta en el disco donde se guardan. En el VPS, fuera del código y dentro del respaldo.
SOPORTES_DIR="/var/lib/joyeria/soportes"
# Solo mientras queden recibos viejos en Vercel Blob (ver scripts/migrar-recibos.ts).
# BLOB_READ_WRITE_TOKEN=

# ─── Facturación electrónica (Alegra) ──────────────────────────────────────────
# Alegra -> Configuración -> Integración Manual (API).
ALEGRA_USUARIO=
ALEGRA_TOKEN=
# "true" SOLO con la cuenta real del cliente ya habilitada ante la DIAN. Vacío = no se envía a la DIAN.
ALEGRA_ENVIAR_DIAN=

# ─── Solo en SU computador (desarrollo) ────────────────────────────────────────
# Servidor(es) de base de datos donde se permite `npm run datos:prueba` / `datos:cero`.
# NUNCA ponerla en el VPS.
# DATOS_PERMITIDOS_HOSTS=ep-xxxx

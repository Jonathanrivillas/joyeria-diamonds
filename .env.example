# Neon -> rama -> Connect. Con "Connection pooling" activado:
DATABASE_URL="postgresql://USUARIO:CLAVE@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
# La misma dirección pero con "Connection pooling" desactivado (sin -pooler):
DIRECT_URL="postgresql://USUARIO:CLAVE@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
# Clave larga y aleatoria (mínimo 32 caracteres):
SESSION_SECRET="cambia-esto-por-una-clave-larga-y-aleatoria"
# Vercel -> Storage -> Blob -> .env.local
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxx"

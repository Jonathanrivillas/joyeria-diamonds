{
  "name": "joyeria-inventario",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:seed": "prisma db seed",
    "setup": "prisma migrate deploy && prisma db seed",
    "verificar": "tsx --env-file=.env scripts/verificar.ts",
    "datos:prueba": "tsx --env-file=.env scripts/datos.ts --prueba --si",
    "datos:cero": "tsx --env-file=.env scripts/datos.ts --cero --si",
    "postinstall": "prisma generate",
    "vercel-build": "prisma migrate deploy && next build",
    "start:vps": "next start -H 127.0.0.1 -p 3000"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jose": "^5.10.0",
    "lucide-react": "^1.72.0",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^2.15.4",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  },
  "engines": {
    "node": ">=20.9"
  }
}
